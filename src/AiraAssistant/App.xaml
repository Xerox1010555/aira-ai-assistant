<Application x:Class="AiraAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AiraAssistant.UI.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Themes/Modern.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:MessageAlignmentConverter x:Key="MessageAlignment" />
            <conv:MessageBackgroundConverter x:Key="MessageBackground" />
            <conv:BoolToMicLabelConverter x:Key="BoolToMicLabel" />
            <!-- Theme brushes are injected at runtime by ThemeEngine.Apply(). -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
