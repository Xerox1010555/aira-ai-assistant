<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:AiraAssistant.UI.ViewModels"
                    xmlns:models="clr-namespace:AiraAssistant.Models">

    <!-- Bubble brushes come from ThemeEngine (app level, DynamicResource). -->

    <DataTemplate x:Key="ChatBubbleTemplate" DataType="{x:Type vm:ChatMessageViewModel}">
        <Grid HorizontalAlignment="{Binding Author, Converter={StaticResource MessageAlignment}}"
              Margin="14,6">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="BubbleShift" Y="12" />
                    <ScaleTransform x:Name="BubbleScale" ScaleX="0.97" ScaleY="0.97" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border x:Name="Bubble"
                    CornerRadius="18,18,18,6"
                    Padding="14,10"
                    MaxWidth="680"
                    Background="{DynamicResource AssistantBubble}"
                    BorderBrush="{DynamicResource BubbleStroke}"
                    BorderThickness="1"
                    Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Bubble" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BubbleShift"
                                                 Storyboard.TargetProperty="Y"
                                                 From="12" To="0" Duration="0:0:0.26">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="0.97" To="1" Duration="0:0:0.26">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BubbleScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="0.97" To="1" Duration="0:0:0.26">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{DynamicResource Foreground}"
                                   FontSize="14"
                                   LineHeight="21"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                   Foreground="{DynamicResource MutedForeground}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DataTemplate.Triggers>
            <!-- User: accent gradient bubble, small bottom-right corner -->
            <DataTrigger Binding="{Binding Author}" Value="User">
                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource UserBubble}" />
                <Setter TargetName="Bubble" Property="CornerRadius" Value="18,18,6,18" />
            </DataTrigger>
            <!-- System / tool: subtle neutral glass -->
            <DataTrigger Binding="{Binding Author}" Value="System">
                <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource SystemBubble}" />
                <Setter TargetName="Bubble" Property="Padding" Value="12,7" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
