<Window x:Class="AiraAssistant.UI.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aira — Settings"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource Foreground}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Themes/Modern.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}" />
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="AI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" Margin="0,0,0,8" />
                <TextBlock Text="AI provider" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding Provider, Mode=TwoWay}" />
                <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022, ..." />
                <TextBlock Text="System prompt (restart applies changes)"
                           Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Theme"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" Margin="0,16,0,4" />
                <TextBlock Text="Visual identity (applies instantly, no restart)" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ThemeBox"
                          ItemsSource="{Binding ThemeNames}"
                          SelectedItem="{Binding ThemeName, Mode=TwoWay}"
                          SelectionChanged="OnThemeChanged" />

                <TextBlock Text="Voice"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" Margin="0,16,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Speech recognition (STT) culture" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding CulturesList}"
                                  SelectedItem="{Binding SttCulture, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Speech synthesis (TTS) culture" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding CulturesList}"
                                  SelectedItem="{Binding TtsCulture, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="TTS voice (empty = pick first matching culture)" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding TtsVoices}"
                              SelectedItem="{Binding TtsVoiceName, Mode=TwoWay}" />
                    <Button Grid.Column="2" Content="Preview"
                            Command="{Binding PreviewVoiceCommand}"
                            Style="{StaticResource GhostButton}" Padding="12,7" />
                </Grid>
                <CheckBox Content="Barge-in: new speech while Aira is talking interrupts her"
                          IsChecked="{Binding BargeInEnabled}" />
                <CheckBox Content="Always on top"
                          IsChecked="{Binding AlwaysOnTop}" />

                <TextBlock Text="API keys"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Accent}" Margin="0,16,0,4" />
                <TextBlock Text="OpenAI API key (DPAPI-encrypted; leave empty to keep current)" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="OpenAiKeyBox" />
                <TextBlock Text="{Binding OpenAiKeyStatus}"
                           Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,2,0,0" />
                <TextBlock Text="Anthropic API key (DPAPI-encrypted; leave empty to keep current)" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="AnthropicKeyBox" />
                <TextBlock Text="{Binding AnthropicKeyStatus}"
                           Foreground="{DynamicResource MutedForeground}" FontSize="11" Margin="0,2,0,0" />

                <TextBlock Text="Notes"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedForeground}" Margin="0,16,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Foreground="{DynamicResource MutedForeground}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="API keys are still edited in appsettings.json next to the app (or via an environment variable). Tool confirmations are controlled by Tools:RequireConfirmation. Settings apply after Save; provider/model/prompt/voice changes need a restart." />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Width="90" IsCancel="True" Click="OnCancel" />
            <Button Grid.Column="2" Content="Save"
                    Style="{StaticResource ModernButton}"
                    Width="90" IsDefault="True" Click="OnSave" />
        </Grid>
    </Grid>
</Window>
