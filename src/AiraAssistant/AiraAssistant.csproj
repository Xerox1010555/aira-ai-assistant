<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Aira.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- tray icon + small interop uses System.Windows.Forms -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AiraAssistant</RootNamespace>
    <AssemblyName>AiraAssistant</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- manifest-based PerMonitorV2 DPI is the standard WPF mechanism;
         the WinForms shim prefers its own API, hence this suppression. -->
    <NoWarn>WFAC010</NoWarn>
    <Version>1.1.0</Version>
    <Authors>Aira</Authors>
    <Description>Always-on Windows AI voice &amp; chat assistant (with SQLite history, tool approvals and tray).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="CoreAudio" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Aira.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    UseWindowsForms injects global usings for System.Windows.Forms and
    System.Drawing, which collide with WPF types (Application, Brush,
    KeyEventArgs, MessageBox...). We use Forms ONLY for the tray NotifyIcon
    with explicit usings inside TrayIconService, so remove the globals.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
